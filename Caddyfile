{
	admin off
	auto_https off
}

# Jacob's Music — local port 8092 (Jori :8090, Wayne :8091 on the same Mac).
# Tailscale:
#   tailscale serve --bg --https=8444 http://127.0.0.1:8092
#   https://<machine>.<tailnet>.ts.net:8444/
# Start from this folder:
#   caddy run --config Caddyfile
:8092 {
	bind 127.0.0.1
	handle /music/* {
		uri strip_prefix /music
		root * music
		header Cache-Control "no-cache"
		file_server
	}

	handle /catalog.json {
		root * music
		header Cache-Control "no-store"
		file_server
	}

	handle /api/youtube-oembed {
		rewrite * /oembed?format=json&{http.request.uri.query}
		reverse_proxy https://www.youtube.com {
			header_up Host www.youtube.com
			header_up User-Agent "Mozilla/5.0"
		}
	}

	handle /api/soundcloud-oembed {
		rewrite * /oembed?format=json&{http.request.uri.query}
		reverse_proxy https://soundcloud.com {
			header_up Host soundcloud.com
		}
	}

	handle /sw.js {
		root * web
		header Cache-Control "no-store"
		file_server
	}

	handle {
		root * web
		encode gzip
		header Cache-Control "no-cache"
		header /manifest.webmanifest Content-Type application/manifest+json
		file_server
	}
}